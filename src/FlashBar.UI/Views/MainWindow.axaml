<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlashBar.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FlashBar.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="FlashBar"
        Width="640"
        SizeToContent="Height"
        MinWidth="480"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding LaunchSelectedCommand}" />
        <KeyBinding Gesture="Down" Command="{Binding SelectNextCommand}" />
        <KeyBinding Gesture="Up" Command="{Binding SelectPreviousCommand}" />
    </Window.KeyBindings>

    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            CornerRadius="8">
        <StackPanel Margin="28" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="FlashBar" FontSize="18" FontWeight="SemiBold" />
            </StackPanel>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Search applications..."
                     FontSize="18"
                     Padding="14,12" />
            <ListBox ItemsSource="{Binding Applications}"
                     SelectedItem="{Binding SelectedApplication}"
                     IsVisible="{Binding HasApplications}"
                     MaxHeight="360"
                     DoubleTapped="OnApplicationDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ApplicationItemViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Grid Width="32" Height="32">
                                <Image Source="{Binding Icon}"
                                       IsVisible="{Binding HasIcon}" />
                                <Border IsVisible="{Binding !HasIcon}"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                        CornerRadius="4">
                                    <TextBlock Text="{Binding Initial}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       FontSize="16" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasStatus}"
                       Foreground="IndianRed"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>

</Window>
